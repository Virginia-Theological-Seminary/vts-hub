# ------------------------------------------------------------------
# VTS Hub — environment variables
# ------------------------------------------------------------------
# Placeholders only. Copy to .env for local development, and set the
# real values in Netlify under Site configuration -> Environment
# variables. Never commit a filled-in copy: .env is git-ignored, and no
# secret, password, API key or private key belongs in this repository.
# ------------------------------------------------------------------

# Signs the session cookie. Required — without it the auth endpoints
# refuse to issue sessions rather than signing with something guessable,
# and documents under /files/ return "Sign-in required".
#
# Generate one with:  openssl rand -base64 48
VTS_SESSION_SECRET=replace-with-secure-secret

# Which provider answers /api/auth/*.
#   development  TEMPORARY DEVELOPMENT AUTHENTICATION — email + password
#                accounts held by the site, for building and testing
#                before Entra exists. The default.
#   entra        Microsoft Entra ID. Not switched on yet: see
#                netlify/edge-functions/lib/providers/entra-auth.js for
#                what remains to be done.
AUTH_MODE=development

# Where the temporary development accounts are kept. Chosen explicitly;
# a backend that cannot be reached is an ERROR, never a fallback.
#   mariadb  the Plesk deployment. Needs the VTS_DB_* values below.
#   blobs    Netlify Blobs (chosen automatically on Netlify when unset)
#   memory   local development ONLY — accounts vanish on restart.
#            Refused outright when NODE_ENV=production.
# Only meaningful while AUTH_MODE=development.
VTS_AUTH_STORE=mariadb

# MariaDB connection for VTS_AUTH_STORE=mariadb. From Plesk -> Databases.
# The user needs rights on this one database only; the table
# (vts_hub_store) is created on first start.
VTS_DB_HOST=localhost
VTS_DB_PORT=3306
VTS_DB_NAME=vtshub
VTS_DB_USER=vtshub
VTS_DB_PASSWORD=replace-with-database-password

# production makes the server refuse to start when it is misconfigured:
# no session secret, no persistent store, or the dev outbox left on.
NODE_ENV=production

# What sign-up asks for, to prove an @vts.edu address belongs to the
# person typing it. The domain rule can only check an address's SHAPE,
# so without one of these anyone could register dean@vts.edu.
#   auto        follow what mail can actually do (the DEFAULT, and the
#               one to leave set). While the sending domain is
#               unverified, mail reaches nobody, so sign-up is by
#               invitation; the day IT publishes the DNS records, the
#               next restart moves to email confirmation by itself.
#   invitation  always by invitation code, issued per address with
#               npm run account -- --invite someone@vts.edu
#   email       always by confirmation link. Only set this when mail is
#               known to work, or nobody will be able to finish signing
#               up. The startup log prints which one is in force.
# Only meaningful while AUTH_MODE=development; Entra replaces all of it.
# VTS_SIGNUP_POLICY=auto

# The long-standing "/?preview" affordance, which renders the tile
# directory without signing in (documents stay protected either way).
# Set to false to switch it off. Ignored once AUTH_MODE=entra.
# VTS_ALLOW_PREVIEW=true

# ------------------------------------------------------------------
# Outgoing mail — confirmation and password-reset links
# ------------------------------------------------------------------
# Sent through Resend (https://resend.com) over its HTTPS API. Both
# values are required for real delivery; with either missing, messages
# go to the function log instead (or to /__dev/outbox on the local dev
# server). The sending domain must be verified in Resend first — it
# shows the DNS records for IT to add.
#
# The key is a secret: the server environment only, never this file.
#
# MAIL_FROM must be an address on a domain that is VERIFIED in Resend
# (Domains -> status "verified"). Two ways this goes wrong, both of
# which the server names in its startup log:
#   - onboarding@resend.dev (Resend's test sender) delivers ONLY to the
#     address that owns the Resend account; everyone else gets nothing.
#   - a domain that is added but whose DNS records are not published
#     (status "failed" / "pending") is refused for every recipient.
RESEND_API_KEY=replace-with-resend-api-key
MAIL_FROM=VTS Hub <noreply@hub.vts.edu>

# The site's public origin, used in links the site sends (confirmation
# and password-reset links). Optional: when unset, the request's own origin
# is used, which on Netlify is the site's canonical address. Set it to
# pin the value so a spoofed Host header can never change a sent link.
# VTS_SITE_URL=https://hub.vts.edu

# Port for the local development server (node dev-server.mjs). Do not
# set on Plesk — Passenger provides it.
# PORT=8888

# The dev server normally captures all mail at /__dev/outbox. Set this
# to false to let it send for real through Resend instead. REQUIRED to be
# false on any deployed server (production refuses to start otherwise) — a way to
# check the key and the verified domain before deploying. Local only;
# the deployed site has no outbox.
# VTS_MAIL_OUTBOX=true

# ------------------------------------------------------------------
# Microsoft Entra ID — not yet active
# ------------------------------------------------------------------
# The two IDs below currently live in site/assets/config.js, which is
# where README step 1 tells VTS IT to put them; they are public
# identifiers, not secrets. They are listed here so the same names are
# ready when AUTH_MODE=entra.
#
# There is NO client secret in this project and none should be created.
# The browser signs in with authorisation code flow + PKCE, and a
# public client cannot keep a secret private.
# ------------------------------------------------------------------

# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_REDIRECT_URI=https://hub.vts.edu/
