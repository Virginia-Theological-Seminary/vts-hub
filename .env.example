# ------------------------------------------------------------------
# VTS Hub — environment variables
# ------------------------------------------------------------------
# Placeholders only. Copy to .env for local development, and set the
# real values in Netlify under Site configuration -> Environment
# variables. Never commit a filled-in copy: .env is git-ignored, and no
# secret, password, API key or private key belongs in this repository.
# ------------------------------------------------------------------

# Signs the session cookie. Required — without it the auth endpoints
# refuse to issue sessions rather than signing with something guessable,
# and documents under /files/ return "Sign-in required".
#
# Generate one with:  openssl rand -base64 48
VTS_SESSION_SECRET=replace-with-secure-secret

# Which provider answers /api/auth/*.
#   development  TEMPORARY DEVELOPMENT AUTHENTICATION — email + password
#                accounts held by the site, for building and testing
#                before Entra exists. The default.
#   entra        Microsoft Entra ID. Not switched on yet: see
#                netlify/edge-functions/lib/providers/entra-auth.js for
#                what remains to be done.
AUTH_MODE=development

# Where the temporary development accounts are kept.
#   (unset)  use Netlify Blobs, falling back to memory if unavailable
#   memory   force in-memory storage — accounts vanish on restart
# Only meaningful while AUTH_MODE=development.
# VTS_AUTH_STORE=memory

# The long-standing "/?preview" affordance, which renders the tile
# directory without signing in (documents stay protected either way).
# Set to false to switch it off. Ignored once AUTH_MODE=entra.
# VTS_ALLOW_PREVIEW=true

# Port for the local development server (node dev-server.mjs).
# PORT=8888

# ------------------------------------------------------------------
# Microsoft Entra ID — not yet active
# ------------------------------------------------------------------
# The two IDs below currently live in site/assets/config.js, which is
# where README step 1 tells VTS IT to put them; they are public
# identifiers, not secrets. They are listed here so the same names are
# ready when AUTH_MODE=entra.
#
# There is NO client secret in this project and none should be created.
# The browser signs in with authorisation code flow + PKCE, and a
# public client cannot keep a secret private.
# ------------------------------------------------------------------

# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_REDIRECT_URI=https://hub.vts.edu/
